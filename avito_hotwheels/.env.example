# Скопируйте этот файл в .env (в корне репозитория) и впишите свои значения.
TG_TOKEN=123456789:AAAA-ваш-токен-от-BotFather
TG_CHAT_ID=123456789
# Запасной режим MTProto (как приложение Telegram), обычно не нужен: бот сам обходит
# блокировку api.telegram.org по IP. Включается TG_MTPROTO=1 + ключи с https://my.telegram.org
TG_MTPROTO=
TG_API_ID=
TG_API_HASH=
AVITO_QUERY=hot wheels
# Секунд между проверками (Авито может блокировать при частых запросах)
INTERVAL=60
# Прокси для Telegram, если провайдер его блокирует (адрес из вашего VPN-клиента),
# например socks5h://127.0.0.1:1080 или http://127.0.0.1:2080
TG_PROXY=
# Необязательно: прокси для Авито, например http://user:pass@host:port
PROXY=
